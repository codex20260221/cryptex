{
    "name": "michaelmawhinney/cryptex",
    "description": "A simple PHP class for 2-way authenticated encryption using XChaCha20 + Poly1305 (libsodium)",
    "keywords": ["encryption", "decryption", "libsodium", "xchacha20", "poly1305", "argon2"],
    "homepage": "https://github.com/michaelmawhinney/cryptex",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Mawhinney",
            "homepage": "https://michaelmawhinney.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-sodium": "*"
    },
    "autoload": {
        "psr-4": {
            "cryptex\\": "src/"
        }
    },
    "scripts": {
        "cs-check": "@php vendor/bin/phpcs --standard=phpcs.xml.dist -n",
        "lint": "@php tools/lint.php",
        "stan": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon --no-progress",
        "test": "@php vendor/bin/phpunit --configuration phpunit.xml.dist"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12",
        "squizlabs/php_codesniffer": "^4.0"
    }
}
